# Mobile app environment. Copy to apps/mobile/.env for a local override.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so
# restart `expo start` after changing them.

# API base URL.
#  - Leave UNSET for local dev: the app auto-derives your machine's LAN IP
#    from the Expo dev server, so it works in Expo Go on simulators AND
#    physical devices with no config.
#  - Set it for `expo start --tunnel`, or for standalone/EAS builds where
#    there is no Metro dev server to derive the host from.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
